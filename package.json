{
  "name": "@incubrain/foundry-workspace",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --filter @incubrain/foundry dev",
    "build": "pnpm run --filter @incubrain/foundry build",
    "dev:foundry": "nuxt dev examples/foundry",
    "build:foundry": "nuxt build examples/foundry > build.log 2>&1",
    "build:ci": "node scripts/build-diagnostic.mjs",
    "build:ci:layer": "node scripts/build-diagnostic.mjs layer",
    "build:ci:foundry": "node scripts/build-diagnostic.mjs examples/foundry",
    "generate": "pnpm -r generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ship": "git push",
    "repomix": "repomix --ignore='examples,deploy,public,**/public/**,context,**/assets/**,.claude,**/content/**/*.{md,yml}'",
    "repomix:new": "{ git ls-files --others --exclude-standard; git diff --name-only; git diff --cached --name-only; } | sort -u | repomix --stdin -o repomix-changed.xml",
    "typecheck": "nuxt typecheck layer",
    "verify": "nuxt prepare layer && pnpm run lint && pnpm run typecheck",
    "layer:check": "pnpm pack --dry-run --filter @incubrain/foundry",
    "layer:release": "release-it --config .release-it.json",
    "layer:release:dry": "release-it --config .release-it.json --dry-run",
    "layer:publish": "cd layer && npm publish --access public",
    "verdaccio:start": "verdaccio --config .verdaccio/config.yaml",
    "verdaccio:status": "node -e \"fetch('http://localhost:4873/-/ping').then(r=>console.log(r.ok?'up':'down (status '+r.status+')')).catch(()=>console.log('down (not reachable)'))\"",
    "layer:publish:local": "pnpm --filter @incubrain/foundry publish:local",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.6",
    "eslint": "^10.8.1",
    "nuxt": "4.5.2",
    "release-it": "^19.2.4",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "undici@5": "^6.28.1",
      "undici@6": "^6.28.1",
      "ws@8": "^8.21.0",
      "ip-address@10": "^10.7.1",
      "js-yaml@4": "^4.3.2",
      "sharp@0.34": "^0.35.5",
      "esbuild@0.28.0": "0.28.2",
      "qs@6": "^6.16.0",
      "@tiptap/core@3": "3.30.5",
      "@tiptap/pm@3": "3.30.5",
      "@modelcontextprotocol/sdk": "^1.32.1",
      "proxy-addr@2": "^2.0.8",
      "fast-uri@3": "^3.1.8",
      "hono@4": "^4.13.11",
      "devalue@5": "^5.9.3",
      "undici@7": "^7.29.1",
      "undici@8": "^8.10.2",
      "sharp@0.35": "^0.35.5",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "source-map-js@1": "^1.2.2",
      "svgo@4": "^4.1.0",
      "seroval@1": "^1.6.3",
      "shell-quote@1": "^1.11.0",
      "handlebars@4": "^4.7.10",
      "postcss-selector-parser@7": "^7.1.6",
      "vue@3": "^3.5.44",
      "@vitest/mocker@4": "^4.1.12",
      "@vue/compiler-core@3": "^3.5.44",
      "@vue/compiler-dom@3": "^3.5.44",
      "@vue/compiler-sfc@3": "^3.5.44",
      "@vue/compiler-ssr@3": "^3.5.44",
      "@vue/reactivity@3": "^3.5.44",
      "@vue/runtime-core@3": "^3.5.44",
      "@vue/runtime-dom@3": "^3.5.44",
      "@vue/server-renderer@3": "^3.5.44",
      "@vue/shared@3": "^3.5.44",
      "vite": "^8.2.4",
      "launch-editor@2": "^2.14.2",
      "zod@4": "^4.6.6"
    }
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "vitest": "^4.1.12"
  }
}
